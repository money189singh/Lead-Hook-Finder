  "business_verifier_rules": {
    "verification_instructions": "Verify the current operational status of the target business using multi-source evidence cross-referencing.\n\nExamine Google Maps operational status, website HTTP accessibility, content recency dates, government registry filings, and recent search reviews.\n\nNever guess. Insufficient or conflicting evidence must be classified as UNCERTAIN.",
    "evidence_requirements": "A business can only be marked OPEN if there is credible current evidence of operation (active website, current reviews, or Google Maps verified operating).\n\nPERMANENTLY CLOSED requires explicit confirmation from Google Maps, government dissolution filings, or closure notices on official domain.\n\nTEMPORARILY CLOSED requires official notice of temporary closure.",
    "search_behavior": "Query closure signals ('permanently closed', 'closed', 'reviews 2026') only when status is not already established by decisive primary sources.",
    "status_rules": "OPEN: Credible current operational evidence.\nTEMPORARILY CLOSED: Confirmed temporary shutdown.\nPERMANENTLY CLOSED: Explicit confirmation of cessation of business.\nUNCERTAIN: Conflicting evidence, outdated information, or unverified.",
    "confidence_rules": "HIGH: Corroborating evidence across 2+ authoritative channels.\nMEDIUM: Single authoritative source without contradiction.\nLOW: Partial or indirect signals.",
    "api_priority": "1. Google Maps / Places\n2. Direct Website Health & Activity\n3. Search API Verification\n4. State Government Registry\n5. AI Evidence Synthesizer (only on conflict/ambiguity)",
    "reverification_intervals": {
      "open_days": 30,
      "uncertain_days": 7,
      "temporarily_closed_days": 14,
      "permanently_closed_days": 0
    },
    "ai_usage_rules": "AI must NOT perform every individual verification action. Collect structured evidence first. Call AI interpreter only when evidence is conflicting or ambiguous.",
    "credit_costs": {
      "low": 0.5,
      "medium": 1,
      "high": 2
    }
