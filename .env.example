# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Required for OpenRouter external company AI research.
# Can also be configured via Settings in the application.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# NVIDIA NIM API (Hosted Cloud AI Worker)
# Endpoint: https://integrate.api.nvidia.com/v1/chat/completions
# Used by the background prospecting and extraction system on DigitalOcean
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DIGITALOCEAN BACKGROUND WORKER CONFIGURATION
# Set on DigitalOcean App Platform or Droplet container:
DIGITALOCEAN_WORKER_ID="leadhook-worker-01"
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=2500
HEARTBEAT_INTERVAL_MS=5000
DISABLE_EMBEDDED_WORKER=false

# OPTIONAL SEARCH & MAPS API KEYS
GOOGLE_MAPS_API_KEY=""
SEARCH_API_KEY=""

# Configured from your Firebase Console project settings:
VITE_FIREBASE_API_KEY="AIzaSyD78Xe1a33PeHj6qiN6Rs0bNBWqG02sJbs"
VITE_FIREBASE_AUTH_DOMAIN="leadhook-6e4cb.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="leadhook-6e4cb"
VITE_FIREBASE_STORAGE_BUCKET="leadhook-6e4cb.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="947979493277"
VITE_FIREBASE_APP_ID="1:947979493277:web:7fda488eb5daac4cab1974"
