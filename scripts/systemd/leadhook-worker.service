[Unit]
Description=LeadHook Firebase / Cloud VM Background Discovery Worker
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/leadhook
ExecStart=/usr/bin/npm run worker
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=WORKER_CONCURRENCY=5
Environment=CLOUD_VM_HOST=true
# Pass your App URL and AI API Keys:
# Environment=APP_API_URL=https://your-cloud-run-app-url.run.app
# Environment=GEMINI_API_KEY=your_gemini_api_key
# Environment=NVIDIA_API_KEY=your_nvidia_api_key

StandardOutput=journal
StandardError=journal
SyslogIdentifier=leadhook-worker

[Install]
WantedBy=multi-user.target
