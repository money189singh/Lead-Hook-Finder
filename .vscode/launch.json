{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LeadHook: Full-Stack Dev (Port 3000)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "PORT": "3000",
        "NODE_ENV": "development"
      }
    },
    {
      "name": "LeadHook: 24/7 Autonomous Background Worker",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "worker"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
